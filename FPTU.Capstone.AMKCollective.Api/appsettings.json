{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "<YOUR_SECRET_KEY_HERE>",
    "Issuer": "<YOUR_ISSUER_HERE>",
    "Audience": "<YOUR_AUDIENCE_HERE>",
    "ExpireMinutes": 120
  },
  "CloudinarySettings": {
    "CloudName": "<YOUR_CLOUDINARY_CLOUDNAME>",
    "ApiKey": "<YOUR_CLOUDINARY_APIKEY>",
    "ApiSecret": "<YOUR_CLOUDINARY_APISECRET>"
  },
  "RedisSettings": {
    "ConnectionString": "<YOUR_REDIS_CONNECTION_STRING>",
    "InstanceName": "<YOUR_REDIS_INSTANCE_NAME>"
  },
  "StripeSettings": {
    "PublishableKey": "<YOUR_PUBLIC_KEY_HERE>",
    "SecretKey": "<YOUR_SECRET_KEY_HERE>",
    "WebhookSecret": "<YOUR_WEBHOOK_SECRET_HERE>"
  },
  "EmailSettings": {
    "From": "<YOUR_EMAIL_FROM>",
    "SmtpServer": "<YOUR_SMTP_SERVER>",
    "Port": 587,
    "Username": "<YOUR_EMAIL_USERNAME>",
    "Password": "<YOUR_EMAIL_PASSWORD>"
  },
  "Cors": {
    "AllowedOrigins": [
      "<YOUR_FRONTEND_URL_1>",
      "<YOUR_FRONTEND_URL_2>"
    ]
  },
  "OrderSettings": {
    "DefaultShippingFee": "<YOUR_DEFAULT_SHIPPING_FEE>",
    "AbandonedOrderTimeoutHours": "<YOUR_TIMEOUT_HOURS>",
    "WarrantyPeriodDays": "<YOUR_WARRANTY_DAYS>",
    "CancellationSpamCheckDays": "<YOUR_CHECK_DAYS>",
    "MaxCancellationsPerPeriod": "<YOUR_MAX_CANCELLATIONS>",
    "ShopCancellationPenaltyRate": "<YOUR_PENALTY_RATE>",
    "ShopResponseTimeoutHours": "<YOUR_RESPONSE_TIMEOUT>"
  },
  "FrontendUrls": {
    "PaymentSuccessPath": "<YOUR_PAYMENT_SUCCESS_URL>",
    "PaymentCancelPath": "<YOUR_PAYMENT_CANCEL_URL>",
    "OrderPendingPath": "<YOUR_ORDER_PENDING_URL>",
    "DepositSuccessPath": "<YOUR_DEPOSIT_SUCCESS_URL>",
    "DepositCancelPath": "<YOUR_DEPOSIT_CANCEL_URL>"
  },
  "BuilderSettings": {
    "SessionExpirationHours": "<YOUR_SESSION_EXPIRATION_HOURS>"
  },
  "VoucherSettings": {
    "NegotiationValidityDays": "<YOUR_NEGOTIATION_VALIDITY_DAYS>",
    "CompensationValidityMonths": "<YOUR_COMPENSATION_VALIDITY_MONTHS>"
  },
  "WalletSettings": {
    "WithdrawalFeePercent": "<YOUR_WITHDRAWAL_FEE_PERCENT>",
    "MinimumBalanceAfterWithdrawal": "<YOUR_MINIMUM_BALANCE>",
    "MinimumWithdrawalAmount": "<YOUR_MINIMUM_WITHDRAWAL_AMOUNT>",
    "PinResetOtpExpiryMinutes": "<YOUR_OTP_EXPIRY_MINUTES>"
  },
  "CommissionSettings": {
    "QuoteValidityDays": "<YOUR_QUOTE_VALIDATE_DAY>"
  },
  "WorkerIntervals": {
    "AbandonedOrderCleanupMinutes": "<YOUR_CLEANUP_MINUTES>",
    "FundsReleaseHours": "<YOUR_FUNDS_RELEASE_HOURS>",
    "OrderCancellationTimeoutMinutes": "<YOUR_CANCELLATION_TIMEOUT_MINUTES>"
  },
  "WarrantySettings": {
    "MaxWithdrawCount": "<YOUR_MAX_WITHDRAW_COUNT>",
    "WarrantyRequestWindowDays": "<YOUR_WARRANTY_REQUEST_WINDOW_DAYS>",
    "ReturnShippingTimeoutDays": "<YOUR_RETURN_SHIPPING_TIMEOUT_DAYS>"
  }
}