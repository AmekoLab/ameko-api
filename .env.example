# ===========================================
# FPTU Capstone AMKCollective - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git (it's in .gitignore)

# Docker Image Configuration
IMAGE=your-dockerhub-username/fptu-capstone-amkcollective:latest
API_PORT=8080

# Nginx Proxy Manager (SSL Reverse Proxy)
# First login defaults are admin@example.com / changeme (you will be asked to change).
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# Dozzle (Logs Viewer)
# Use none to rely on NPM Access List only. Set to simple to enable internal Dozzle login.
DOZZLE_AUTH_PROVIDER=none

# Database Configuration
DB_HOST=mysql-server-host
DB_PORT=3306
DB_NAME=AmekoDB
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL_MODE=Required
DB_TREAT_TINY_AS_BOOLEAN=true

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-min-32-characters-long
JWT_ISSUER=ameko-be.com
JWT_AUDIENCE=ameko-fe.com
JWT_EXPIRE_MINUTES=120

# Cloudinary Settings (Image Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis Settings (Caching)
REDIS_CONNECTION_STRING=your-redis-host:6379
REDIS_INSTANCE_NAME=Ameko

# Email Settings (SMTP)
EMAIL_FROM=your-email@gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# CORS Settings
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=https://your-frontend-domain.com

# Additional App Settings (Section__Property format)
# These variables are loaded directly from .env into the container.
# Naming rule: Section__Property maps to appsettings JSON path Section:Property.

# Stripe Settings
StripeSettings__PublishableKey=your-stripe-publishable-key
StripeSettings__SecretKey=your-stripe-secret-key
StripeSettings__WebhookSecret=your-stripe-webhook-secret

# Security Settings
SecuritySettings__RefreshTokenLimit=5
SecuritySettings__VerificationCodeExpiryMinutes=15
SecuritySettings__UnverifiedAccountDeletionHours=24
SecuritySettings__MaxCommentsPerMinute=60
SecuritySettings__MaxCommentEditsPerDay=10

# Order Settings
OrderSettings__DefaultShippingFee=0
OrderSettings__AbandonedOrderTimeoutHours=24
OrderSettings__WarrantyPeriodDays=30
OrderSettings__CancellationSpamCheckDays=7
OrderSettings__MaxCancellationsPerPeriod=4
OrderSettings__ShopCancellationPenaltyRate=0.1
OrderSettings__CustomerCancellationPenaltyRate=0.1
OrderSettings__ShopResponseTimeoutHours=24
OrderSettings__MaxInProgressOrdersPerShopCustomer=5
OrderSettings__ShopPayoutRate=0.8
OrderSettings__SystemVoucherPlatformShareRate=0.7
OrderSettings__SystemVoucherShopShareRate=0.3
OrderSettings__SystemVoucherShopShareCap=50000
OrderSettings__ShopAssemblyInitTimeoutHours=48
OrderSettings__CustomerResponseSlaHours=24
OrderSettings__CustomerResponseReminderMaxCount=3

# Frontend URLs
FrontendUrls__PaymentSuccessPath=http://localhost:3000/payment-success
FrontendUrls__PaymentCancelPath=http://localhost:3000/payment/cancel
FrontendUrls__OrderPendingPath=http://localhost:3000/orders?status=pending
FrontendUrls__DepositSuccessPath=http://localhost:3000/payment-success
FrontendUrls__DepositCancelPath=http://localhost:3000/wallet/deposit-cancel

# Builder and Voucher
BuilderSettings__SessionExpirationHours=48
VoucherSettings__NegotiationValidityDays=7
VoucherSettings__CompensationValidityMonths=1

# Wallet Settings
WalletSettings__WithdrawalFeePercent=0.002
WalletSettings__MinimumBalanceAfterWithdrawal=1000000
WalletSettings__MinimumWithdrawalAmount=100000
WalletSettings__PinResetOtpExpiryMinutes=5
WalletSettings__DaysBetweenRequests=15

# Commission Settings
CommissionSettings__QuoteValidityDays=7
CommissionSettings__DefaultShopResponseHours=24
CommissionSettings__DefaultCustomerResponseHours=24
CommissionSettings__ReminderIntervalHours=24
CommissionSettings__MaxReminderCount=3
CommissionSettings__MaxActiveRequests=50
CommissionSettings__PaymentWindowHours=48

# Worker Intervals
WorkerIntervals__AbandonedOrderCleanupMinutes=30
WorkerIntervals__FundsReleaseHours=1
WorkerIntervals__OrderCancellationTimeoutMinutes=30
WorkerIntervals__CommissionReminderMinutes=30
WorkerIntervals__AssemblyTrackingTimeoutMinutes=30
WorkerIntervals__UnverifiedAccountCleanupMinutes=60

# System and Warranty
SystemSettings__SystemBotId=00000000-0000-0000-0000-000000000001
WarrantySettings__MaxWithdrawCount=3
WarrantySettings__WarrantyRequestWindowDays=7
WarrantySettings__ReturnShippingTimeoutDays=7

# VNPay Settings
Vnpay__TmnCode=your-vnpay-tmn-code
Vnpay__HashSecret=your-vnpay-hash-secret
Vnpay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Vnpay__ReturnUrl=http://localhost:3000/payment/vnpay-return
Vnpay__IpnUrl=https://your-api-domain.com/api/v1/payment/vnpay-ipn
Vnpay__Command=pay
Vnpay__CurrCode=VND
Vnpay__Version=2.1.0
Vnpay__Locale=vn

# Quality Score Settings
QualityScoreSettings__TimeWindowDays=30
QualityScoreSettings__BatchSize=50
QualityScoreSettings__MinimumOrdersRequired=3
QualityScoreSettings__DefaultScore=100
QualityScoreSettings__MaxIssueRateThreshold=20
QualityScoreSettings__IdealResponseHours=1
QualityScoreSettings__MaxResponseHoursThreshold=24
QualityScoreSettings__MaxRefundRateThreshold=10
QualityScoreSettings__IdealRepurchaseRateThreshold=30
QualityScoreSettings__Weights__Issue=0.3
QualityScoreSettings__Weights__Response=0.25
QualityScoreSettings__Weights__Refund=0.15
QualityScoreSettings__Weights__Repurchase=0.15
QualityScoreSettings__Weights__Feedback=0.15
QualityScoreSettings__BadgeThresholds__Premium=85
QualityScoreSettings__BadgeThresholds__Verified=70

# Reputation Settings
ReputationSettings__MinScore=0
ReputationSettings__MaxScore=100
ReputationSettings__DefaultCustomerScore=100
ReputationSettings__DefaultShopScore=100
ReputationSettings__CustomerHighMinScore=90
ReputationSettings__CustomerMidMinScore=80
ReputationSettings__CustomerLowMinScore=50
ReputationSettings__CustomerHighMonthlyOrderLimit=0
ReputationSettings__CustomerMidMonthlyOrderLimit=10
ReputationSettings__CustomerLowMonthlyOrderLimit=3
ReputationSettings__CustomerHighCanUseAdminVoucher=true
ReputationSettings__CustomerMidCanUseAdminVoucher=false
ReputationSettings__CustomerLowCanUseAdminVoucher=false
ReputationSettings__ShopHighMinScore=90
ReputationSettings__ShopMidMinScore=80
ReputationSettings__ShopLowMinScore=60
ReputationSettings__ShopHighMonthlyOrderLimit=0
ReputationSettings__ShopMidMonthlyOrderLimit=20
ReputationSettings__ShopLowMonthlyOrderLimit=10
ReputationSettings__ShopHighCanCreateVoucher=true
ReputationSettings__ShopMidCanCreateVoucher=true
ReputationSettings__ShopLowCanCreateVoucher=false
ReputationSettings__MaxMonthlyAutoCancels=10
ReputationSettings__SlowResponseResetSuccessCount=3
ReputationSettings__PointsPerSuccessfulOrder=5
ReputationSettings__PointsDeductArtisanFault=5
ReputationSettings__PointsDeductNoResponseAfterAccept=5
ReputationSettings__PointsDeductValidComplaint=5
ReputationSettings__PointsDeductIgnoredRequest=2

# AI Settings
AISettings__GoogleApiKey=your-google-api-key
AISettings__GoogleModelName=models/gemini-embedding-001
AISettings__GroqApiKey=your-groq-api-key
AISettings__GroqModelName=llama-3.3-70b-versatile
AISettings__OpenAiApiKey=your-openai-api-key
AISettings__OpenAiModelName=gpt-4o-mini
AISettings__GroqUrl=https://api.groq.com/openai/v1/chat/completions
AISettings__OpenAiUrl=https://api.openai.com/v1/chat/completions
AISettings__RecommendationPrompt=You are a custom keyboard expert. Return JSON only.
AISettings__OrderIssuePrompt=You are a marketplace support assistant. Return JSON only.
AISettings__Qdrant__Url=https://your-cluster.qdrant.io
AISettings__Qdrant__ApiKey=your-qdrant-api-key
AISettings__Qdrant__Port=6334

# Timezone Settings
TimeZoneSettings__Windows=SE Asia Standard Time
TimeZoneSettings__Iana=Asia/Ho_Chi_Minh
TimeZoneSettings__FallbackOffsetHours=7

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
